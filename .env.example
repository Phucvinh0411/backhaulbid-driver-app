# Copy this file to .env and replace the sample IPv4 with your PC's LAN IPv4.
# Physical Android device: http://<PC-LAN-IPv4>:8080
# Android emulator: http://10.0.2.2:8080
# Browser on the PC: http://localhost:8080
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.25:8080
EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# EXPO_PUBLIC_* values are embedded in the app bundle. Keep secrets on the server.
